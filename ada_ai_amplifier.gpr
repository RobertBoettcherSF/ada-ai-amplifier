with "config/ada_ai_amplifier_config.gpr";

project Ada_AI_Amplifier is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ada_AI_Amplifier_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("hello.adb", "tensors_test.adb", "mlp_test.adb",
      "attention_test.adb", "recurse_test.adb", "recurse_cli.adb",
      "traces_test.adb", "traces_cli.adb",
      "audit_test.adb", "audit_cli.adb",
      "reward_test.adb", "reward_cli.adb",
      "harness_test.adb", "harness_cli.adb");

   package Compiler is
      --  -gnata checks the Pre and Post on AI_Amplifier.Tensors.
      --  Range checks stay on; -gnatp is not added.
      for Default_Switches ("Ada") use
        Ada_AI_Amplifier_Config.Ada_Compiler_Switches & ("-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   --  prove.sh runs GNATprove with these switches. Units with
   --  SPARK_Mode => Off are not proof targets. CI runs the same
   --  command. --level=2 selects the provers. Its own timeout is a
   --  few seconds, which was not enough for three checks on the CI
   --  runner. --timeout=120 is the wall-clock pin for that machine.
   --  Steps stay at the level-2 default (no separate step cap).
   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2",
         "--timeout=120",
         "--report=all",
         "--checks-as-errors=on");
   end Prove;

end Ada_AI_Amplifier;
