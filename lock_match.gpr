--  Small native build so tools/check-locked.py can apply the
--  lock-compare rule before the full crate is built.
project Lock_Match is

   for Source_Dirs use ("src");
   for Source_Files use
     ("ai_amplifier.ads",
      "ai_amplifier-lock_rule.ads",
      "ai_amplifier-lock_rule.adb",
      "lock_match.adb");
   for Object_Dir use "obj/lock_match";
   for Exec_Dir use "bin";
   for Main use ("lock_match.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Lock_Match;
